# ============================================================
# WorkSense AI - Backend Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.

# ---- Application ----
APP_NAME=WorkSense AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Database ----
# Use postgresql for production / Docker:
# DATABASE_URL=postgresql+psycopg2://worksense:worksense@localhost:5432/worksense
# Use sqlite for local development / testing (no install needed):
DATABASE_URL=sqlite:///./worksense.db

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ---- WebSocket ----
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_RECONNECT_MAX_RETRIES=5

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=120

# ---- AI Module ----
AI_MODELS_DIR=models/saved
AI_USE_DEMO_DATA=true
AI_MIN_SAMPLES_FOR_TRAINING=50
AI_PREDICTION_HORIZON_MINUTES=30

# ---- Agent ----
AGENT_TOKEN=
AGENT_METRICS_BATCH_SIZE=20
AGENT_COLLECTION_INTERVAL_SECONDS=60
